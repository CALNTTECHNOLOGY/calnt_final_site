---
interface Props { title: string; intro?: string }
const { title, intro } = Astro.props;
---
<section class="bg-slate-50">
  <div class="mx-auto max-w-6xl px-4 py-14">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{title}</h1>
    {intro && <p class="mt-3 max-w-2xl text-lg text-slate-600">{intro}</p>}
  </div>
</section>
