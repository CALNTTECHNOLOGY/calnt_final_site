---
interface Props { eyebrow?: string; title: string; intro?: string }
const { eyebrow, title, intro } = Astro.props;
---
<section class="relative overflow-hidden bg-navy text-white">
  <div class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-brand/30 blur-3xl"></div>
  <div class="container-x relative py-16 sm:py-20">
    {eyebrow && <p class="eyebrow text-sky-300">{eyebrow}</p>}
    <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
    {intro && <p class="mt-4 max-w-2xl text-lg text-blue-100/80">{intro}</p>}
  </div>
</section>
