---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Thank you" noindex>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <h1 class="h-section text-slate-900">Thanks! Your message was sent.</h1>
    <p class="mt-3 text-slate-600">We'll get back to you soon.</p>
    <a href="/" class="mt-6 inline-block font-semibold text-leaf hover:underline">Back to home</a>
  </section>
</Layout>
