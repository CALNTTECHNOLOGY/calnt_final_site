---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found" noindex>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <p class="font-semibold text-brand">404</p>
    <h1 class="mt-2 text-3xl font-bold text-slate-900">Page not found</h1>
    <p class="mt-3 text-slate-600">The page you're looking for doesn't exist or has moved.</p>
    <a href="/" class="mt-6 inline-block font-semibold text-brand hover:underline">Back to home</a>
  </section>
</Layout>
