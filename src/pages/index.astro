---
import Layout from '../layouts/Layout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site } from '../site.config';

const tel = `tel:${site.phone.replace(/\s/g, '')}`;
const points = [
  'Design, supply & installation by one team',
  'Net metering & DISCOM approvals handled',
  'PM Surya Ghar subsidy support for homes',
];
---
<Layout>
  <!-- STEP 1: HERO -->
  <section class="relative overflow-hidden bg-navy text-white">
    <!-- subtle solar-cell grid -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.07] [background-image:linear-gradient(white_1px,transparent_1px),linear-gradient(90deg,white_1px,transparent_1px)] [background-size:56px_40px] [mask-image:linear-gradient(to_left,black,transparent_70%)]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-40 right-0 h-[30rem] w-[30rem] rounded-full bg-brand/40 blur-[120px]"></div>

    <div class="container-x relative grid items-center gap-12 py-14 lg:grid-cols-[1.15fr_1fr] lg:py-20">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1.5 text-sm text-blue-50 ring-1 ring-white/15">
          <span class="h-2 w-2 rounded-full bg-sun"></span>
          Homes: subsidy up to ₹78,000 under PM Surya Ghar
        </p>
        <h1 class="h-display mt-6">
          Your Solar EPC partner for <span class="text-sky-300">homes</span> and <span class="text-sky-300">industry</span>.
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-blue-100">
          {site.legalName} engineers, procures and installs complete solar power systems,
          from rooftop homes to commercial and industrial sites across India.
        </p>
        <ul class="mt-8 space-y-3">
          {points.map((p) => (
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-leaf" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16zm3.7-9.3a1 1 0 0 0-1.4-1.4L9 10.6 7.7 9.3a1 1 0 0 0-1.4 1.4l2 2a1 1 0 0 0 1.4 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-blue-50">{p}</span>
            </li>
          ))}
        </ul>
        <p class="mt-8 text-blue-100">
          Prefer to talk? <a href={tel} class="font-semibold text-white underline decoration-sun decoration-2 underline-offset-4 hover:text-sun">Call {site.phone}</a>
        </p>
      </div>

      <QuoteForm />
    </div>
  </section>
</Layout>
