---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { site } from '../site.config';
import hero from '../assets/rooftop-hero.jpg';

const segments = [
  {
    title: 'Residential Solar',
    text: 'Rooftop solar for independent houses, villas and apartments. Cut your monthly electricity bill, with help on PM Surya Ghar subsidy paperwork.',
    href: '/services#residential',
  },
  {
    title: 'Commercial Solar',
    text: 'Rooftop and ground-mounted systems for offices, factories, schools, hospitals and warehouses. Lower operating costs and meet sustainability goals.',
    href: '/services#commercial',
  },
];

const steps = [
  { title: 'Site survey', text: 'We assess your roof, shading and power usage.' },
  { title: 'Design & quote', text: 'A system sized to your needs, with a clear, itemised quote.' },
  { title: 'Installation', text: 'Quality panels, inverters and structures installed by our team.' },
  { title: 'Net metering & handover', text: 'We handle DISCOM paperwork and commission your system.' },
];
---
<Layout>
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 md:grid-cols-2 md:py-20">
    <div>
      <p class="font-semibold text-leaf">Solar EPC · Residential & Commercial</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        Switch to solar. <span class="text-brand">Save on every bill.</span>
      </h1>
      <p class="mt-5 text-lg text-slate-600">
        {site.legalName} designs, supplies and installs complete solar power systems
        for homes and businesses across India, from first survey to switch-on.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contact" class="rounded-lg bg-brand px-5 py-3 font-semibold text-white hover:bg-brand-dark">Get a free quote</a>
        <a href={`https://wa.me/${site.whatsapp}`} class="rounded-lg border border-leaf px-5 py-3 font-semibold text-leaf hover:bg-leaf hover:text-white" rel="noopener">WhatsApp us</a>
      </div>
    </div>
    <Image
      src={hero}
      alt="Solar panels installed on a rooftop by CALNT Technology"
      widths={[400, 720]}
      sizes="(min-width: 768px) 50vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="aspect-[4/3] w-full rounded-2xl object-cover shadow-lg md:aspect-[4/5]"
    />
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-3xl font-bold text-slate-900">Solar solutions for every roof</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {segments.map((s) => (
          <a href={s.href} class="group rounded-2xl bg-white p-7 shadow-sm ring-1 ring-slate-100 hover:ring-brand">
            <h3 class="text-xl font-semibold text-slate-900 group-hover:text-brand">{s.title}</h3>
            <p class="mt-2 text-slate-600">{s.text}</p>
            <span class="mt-4 inline-block font-semibold text-brand">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-3xl font-bold text-slate-900">How it works</h2>
    <p class="mt-2 text-slate-600">One team handles everything: engineering, procurement and construction.</p>
    <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s, i) => (
        <li class="rounded-2xl p-6 ring-1 ring-slate-200">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-sun/15 font-bold text-amber-700">{i + 1}</span>
          <h3 class="mt-4 font-semibold text-slate-900">{s.title}</h3>
          <p class="mt-1 text-slate-600">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="bg-brand">
    <div class="mx-auto max-w-6xl px-4 py-14 text-center text-white">
      <h2 class="text-3xl font-bold">Find out how much you can save</h2>
      <p class="mt-2 text-blue-100">Free site survey and quote, with no obligation.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/contact" class="rounded-lg bg-white px-5 py-3 font-semibold text-brand hover:bg-blue-50">Request a quote</a>
        <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="rounded-lg border border-white/60 px-5 py-3 font-semibold hover:bg-white/10">Call {site.phone}</a>
      </div>
    </div>
  </section>
</Layout>
