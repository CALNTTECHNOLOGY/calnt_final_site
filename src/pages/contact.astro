---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../site.config';
const input = 'mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20';
---
<Layout title="Contact Us" description={`Contact ${site.name} for a free solar site survey and quote. Call ${site.phone} or email ${site.email}.`}>
  <PageHeader title="Get a free solar quote" intro="Tell us about your home or business and we will get back to you soon." />
  <section class="mx-auto grid max-w-5xl gap-10 px-4 py-14 md:grid-cols-3">
    <form action="https://api.web3forms.com/submit" method="POST" class="space-y-4 md:col-span-2">
      <input type="hidden" name="access_key" value={site.web3formsKey} />
      <input type="hidden" name="subject" value={`New message from ${site.name} website`} />
      <input type="hidden" name="redirect" value={`${site.url}/thanks`} />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />
      <label class="block text-sm font-medium">Name
        <input name="name" required autocomplete="name" class={input} />
      </label>
      <label class="block text-sm font-medium">Email
        <input name="email" type="email" required autocomplete="email" class={input} />
      </label>
      <label class="block text-sm font-medium">Phone
        <input name="phone" type="tel" required autocomplete="tel" class={input} />
      </label>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block text-sm font-medium">Property type
          <select name="property_type" class={input}>
            <option>Residential</option>
            <option>Commercial</option>
          </select>
        </label>
        <label class="block text-sm font-medium">City
          <input name="city" autocomplete="address-level2" class={input} />
        </label>
      </div>
      <label class="block text-sm font-medium">Message (optional: roof size, monthly bill, etc.)
        <textarea name="message" rows="5" class={input}></textarea>
      </label>
      <button type="submit" class="rounded-lg bg-brand px-5 py-3 font-semibold text-white hover:bg-brand-dark">Send message</button>
    </form>
    <aside class="space-y-4 text-slate-600">
      <div><h2 class="font-semibold text-slate-900">Email</h2><a class="hover:text-brand" href={`mailto:${site.email}`}>{site.email}</a></div>
      <div><h2 class="font-semibold text-slate-900">Phone</h2><a class="hover:text-brand" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></div>
      <div><h2 class="font-semibold text-slate-900">WhatsApp</h2><a class="hover:text-brand" href={`https://wa.me/${site.whatsapp}`} rel="noopener">Chat with us</a></div>
      <div><h2 class="font-semibold text-slate-900">Location</h2><p>{site.address}</p></div>
    </aside>
  </section>
</Layout>
